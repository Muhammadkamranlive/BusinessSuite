# BusinessSuite Email API — copy to .env and fill in values (never commit .env)

GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=BusinessSuite ERP
MAIL_FROM=your-sender@gmail.com

# Shared secret — ERP sends this as x-email-api-key header
EMAIL_API_KEY=change-me-to-a-long-random-string

PORT=8787

# true = log only, no SMTP send (safe for staging)
EMAIL_DRY_RUN=false

# Optional persistent path for templates/outbox (use a volume on cloud hosts)
# EMAIL_DATA_DIR=/data
