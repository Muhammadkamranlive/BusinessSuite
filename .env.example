# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New API keys (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Server-only — never expose in the browser / never use NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Optional for automated SQL migrations
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# When false, skip dual-write of HRM / Workday to Supabase. Default: on when SUPABASE_SECRET_KEY is set.
# NEXT_PUBLIC_HRM_USE_SUPABASE=false
# Automation rules + login emails use Supabase when SUPABASE_SECRET_KEY is set (default on).
# NEXT_PUBLIC_AUTOMATION_USE_SUPABASE=false

# When false, skip dual-write of CRM / Sales / Purchase / Inventory / Finance to Supabase. Default: on.
# NEXT_PUBLIC_OPS_USE_SUPABASE=false

# Use Supabase Postgres as source of truth (pull on login; skip browser demo seeds). Recommended for client demos.
NEXT_PUBLIC_DB_PRIMARY=true

# App URL (used as Stripe PaymentIntent return_url)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Shared Email & Notification API (email-api/ — deploy on Render / Railway / Firebase)
# Local: npm run email:dev  ·  Production: see docs/DEPLOY-ONLINE.md
EMAIL_API_URL=http://127.0.0.1:8787
EMAIL_API_KEY=dev-email-key-change-me

# Stripe — SaaS subscriptions (Elements) + HRM payments
# Use Payment Element on /signup and /settings/billing (not Checkout redirect)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Zoom OAuth (HRM /hrm/workflows → Connect Zoom)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/zoom/callback
# Optional Server-to-Server app (meeting creation without user OAuth)
# ZOOM_ACCOUNT_ID=
